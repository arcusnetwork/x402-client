# Paying wallet. Use a dedicated key with a small balance. Never commit it.
PRIVATE_KEY=0x...

# arc-testnet (default) or arc
NETWORK=arc-testnet

# Optional RPC overrides, used for balance checks
# ARC_RPC_URL=https://rpc.mainnet.arc.io
# ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Used by `npm run example`
SERVER_URL=http://localhost:4021
